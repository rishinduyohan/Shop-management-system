<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Text?>

<BorderPane prefHeight="600.0" prefWidth="1000.0" style="-fx-background-color: linear-gradient(to bottom right, #f1f8e9, #ffffff);" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.mainController.DashboardController">

    <!-- ========== TOP BAR ========== -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #2e7d32; -fx-padding: 15;                      -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 10, 0, 0, 4);">
            <ImageView fitHeight="40" fitWidth="40">
                <image>
                    <Image url="@../images/Screenshot%202025-10-10%20230012.png" />
                </image>
            </ImageView>
            <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;" text="Thogakade Shop Management System" />
            <Pane HBox.hgrow="ALWAYS" />
            <Button onAction="#btnLogoutOnAction" style="-fx-background-color: white; -fx-text-fill: #2e7d32;                            -fx-background-radius: 10; -fx-font-size: 13px; -fx-cursor: hand;" text="Logout" />
        </HBox>
    </top>

    <!-- ========== SIDE MENU ========== -->
    <left>
        <VBox alignment="TOP_CENTER" prefWidth="220.0" spacing="20" style="-fx-background-color: #e8f5e9; -fx-padding: 25;">
            <StackPane prefHeight="100" prefWidth="100" style="-fx-background-radius: 50; -fx-overflow: hidden;">
                <ImageView fitHeight="100" fitWidth="100">
                    <image>
                        <Image url="@../images/download.png" />
                    </image>
                </ImageView>
            </StackPane>

            <Label style="-fx-font-size: 15px; -fx-text-fill: #2e7d32; -fx-font-weight: bold;" text="Welcome, Admin" />
            <Separator prefWidth="180" />

            <Button onAction="#btnDashboardOnAction" prefWidth="180" style="-fx-background-color: #2e7d32; -fx-text-fill: white;                            -fx-font-size: 14px; -fx-background-radius: 8;" text="Dashboard" />
            <Button onAction="#btnCustomersOnAction" prefWidth="180" style="-fx-background-color: white; -fx-text-fill: #2e7d32;                            -fx-border-color: #2e7d32; -fx-border-radius: 8;                            -fx-font-size: 14px;" text="Customer Management" />
            <Button onAction="#btnItemsOnAction" prefWidth="180" style="-fx-background-color: white; -fx-text-fill: #2e7d32;                            -fx-border-color: #2e7d32; -fx-border-radius: 8;                            -fx-font-size: 14px;" text="Item Management" />
            <Button onAction="#btnSuppliersOnAction" prefWidth="180" style="-fx-background-color: white; -fx-text-fill: #2e7d32;                            -fx-border-color: #2e7d32; -fx-border-radius: 8;                            -fx-font-size: 14px;" text="Supplier Management" />
            <Button onAction="#btnEmployeesOnAction" prefWidth="180" style="-fx-background-color: white; -fx-text-fill: #2e7d32;                            -fx-border-color: #2e7d32; -fx-border-radius: 8;                            -fx-font-size: 14px;" text="Employee Management" />

            <Pane VBox.vgrow="ALWAYS" />
            <Label style="-fx-text-fill: #777; -fx-font-size: 11px;" text="© 2025 Thogakade Pvt Ltd" />
        </VBox>
    </left>

    <!-- ========== MAIN CONTENT ========== -->
    <center>
        <AnchorPane fx:id="mainContent" prefHeight="500.0" prefWidth="700.0" style="-fx-background-color: white; -fx-padding: 20;                            -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 4);" BorderPane.alignment="CENTER">

            <children>

                <!-- HEADER -->
                <Label layoutX="240.0" layoutY="10.0" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1b5e20;" text="Welcome to Thogakade Dashboard!" />

                <!-- STAT CARDS -->
                <HBox alignment="CENTER" layoutX="40.0" layoutY="87.0" spacing="25">
                    <VBox alignment="CENTER" prefHeight="100" prefWidth="140" style="-fx-background-color: #e8f5e9; -fx-background-radius: 12;                                  -fx-padding: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 4, 0, 0, 2);">
                        <Label style="-fx-font-size: 13px; -fx-text-fill: #1b5e20;" text="Customers" />
                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="120+" />
                    </VBox>

                    <VBox alignment="CENTER" prefHeight="100" prefWidth="140" style="-fx-background-color: #e3f2fd; -fx-background-radius: 12;                                  -fx-padding: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 4, 0, 0, 2);">
                        <Label style="-fx-font-size: 13px; -fx-text-fill: #0d47a1;" text="Items" />
                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="85+" />
                    </VBox>

                    <VBox alignment="CENTER" prefHeight="100" prefWidth="140" style="-fx-background-color: #fff3e0; -fx-background-radius: 12;                                  -fx-padding: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 4, 0, 0, 2);">
                        <Label style="-fx-font-size: 13px; -fx-text-fill: #e65100;" text="Suppliers" />
                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="35+" />
                    </VBox>

                    <VBox alignment="CENTER" prefHeight="100" prefWidth="140" style="-fx-background-color: #f3e5f5; -fx-background-radius: 12;                                  -fx-padding: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 4, 0, 0, 2);">
                        <Label style="-fx-font-size: 13px; -fx-text-fill: #4a148c;" text="Employees" />
                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="20+" />
                    </VBox>
                </HBox>

                <!-- CHART SECTION -->
                <HBox alignment="CENTER" layoutX="40.0" layoutY="227.0" spacing="30">

                    <!-- Bar Chart -->
                    <VBox>
                        <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2e7d32;" text="Monthly Sales Overview" />
                  <ImageView fitHeight="194.0" fitWidth="343.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../images/img%20bar.png" />
                     </image>
                  </ImageView>
                    </VBox>

                    <!-- Pie Chart -->
                    <VBox>
                        <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2e7d32;" text="Product Category Breakdown" />
                  <ImageView fitHeight="225.0" fitWidth="337.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../images/ChatGPT%20Image%20Oct%2015,%202025,%2010_22_53%20PM.png" />
                     </image>
                  </ImageView>
                    </VBox>
                </HBox>
            <Text fill="#1b5e20" layoutX="221.0" layoutY="55.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Smart insights, simple management , everything your shop needs, right here." wrappingWidth="422.93658447265625" />
            <Text fill="#2e7d32" layoutX="43.0" layoutY="472.0" strokeType="OUTSIDE" strokeWidth="0.0" text="The Thogakade Dashboard serves as the central control hub of the system, providing a clear and interactive view of business performance. It combines essential analytics, real-time summaries, and quick navigation options for smooth management operations." wrappingWidth="702.9367065429688" />
            <Line endX="611.2000122070312" layoutX="139.0" layoutY="210.0" startX="-100.0" stroke="#1b5e20" />
            <Line endX="611.2000122070312" layoutX="145.0" layoutY="441.0" startX="-100.0" stroke="#1b5e20" />

            </children>
        </AnchorPane>
    </center>

</BorderPane>
